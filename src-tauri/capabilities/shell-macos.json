{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-macos",
  "description": "macOS 终端/快照 shell 白名单（高权限边界，见 docs/release.md §5-0）：git/claude/codex/node/npm；文件管理器走 opener，不需要 shell",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "git", "cmd": "git", "args": true },
        { "name": "claude", "cmd": "claude", "args": true },
        { "name": "codex", "cmd": "codex", "args": true },
        { "name": "npm", "cmd": "npm", "args": true },
        { "name": "node", "cmd": "node", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "git", "cmd": "git", "args": true },
        { "name": "claude", "cmd": "claude", "args": true },
        { "name": "codex", "cmd": "codex", "args": true },
        { "name": "npm", "cmd": "npm", "args": true },
        { "name": "node", "cmd": "node", "args": true }
      ]
    },
    "shell:allow-kill",
    "shell:allow-stdin-write"
  ]
}
